{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flik.app/schemas/catalog-1.0.json",
  "title": "FLIK Catalog v1",
  "description": "Contrato cerrado del catálogo de FLIK para películas y series.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "generated_at", "items"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "kind": {
          "enum": ["movie", "series"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "original_title": {
          "type": "string",
          "maxLength": 200
        },
        "synopsis": {
          "type": "string",
          "maxLength": 5000
        },
        "year": {
          "type": "integer",
          "minimum": 1888,
          "maximum": 2100
        },
        "genres": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9 -]{0,31}$"
          }
        },
        "poster_uri": {
          "type": "string",
          "pattern": "^(https?://|asset:)"
        },
        "backdrop_uri": {
          "type": "string",
          "pattern": "^(https?://|asset:)"
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "runtime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "external_ids": {
          "$ref": "#/$defs/external_ids"
        },
        "cast": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "directors": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "seasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/season"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "movie" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["variants"],
            "not": { "required": ["seasons"] }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "series" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["seasons"],
            "not": { "required": ["variants"] },
            "properties": {
              "runtime_minutes": false
            }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quality", "magnet_uri"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "quality": {
          "enum": ["2160p", "1080p", "720p", "480p", "unknown"]
        },
        "magnet_uri": {
          "type": "string",
          "pattern": "^magnet:\\?xt=urn:btih:(?:[0-9a-fA-F]{40}|[A-Z2-7]{32})(?:&.*)?$"
        },
        "file_index": {
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "video_codec": {
          "enum": ["h264", "hevc", "av1", "vp9", "unknown"]
        },
        "audio_codecs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": ["aac", "mp3", "ac3", "eac3", "dts", "flac", "opus", "vorbis", "truehd"]
          }
        },
        "audio_languages": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          }
        },
        "subtitle_languages": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          }
        },
        "release_label": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season_number", "episodes"],
      "properties": {
        "season_number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "episodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/episode"
          }
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "episode_number", "title", "variants"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "episode_number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "synopsis": {
          "type": "string",
          "maxLength": 5000
        },
        "runtime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "still_uri": {
          "type": "string",
          "pattern": "^(https?://|asset:)"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "external_ids": {
      "type": "object",
      "maxProperties": 10,
      "patternProperties": {
        "^[a-z0-9_]{1,16}$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    }
  }
}
