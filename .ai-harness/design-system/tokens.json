{
  "$schema": "design-tokens/1.0.0",
  "meta": {
    "name": "<PROYECTO> Design Tokens",
    "version": "1.0.0",
    "updated": "<YYYY-MM-DD>",
    "authority": "values",
    "notes": "Fuente unica de valores visuales. Ningun otro documento repite estos valores. Los valores de esta plantilla son ejemplos neutros: sustituyelos por la marca real."
  },
  "color": {
    "surface": {
      "canvas": "#0B0E14",
      "base": "#121722",
      "elevated": "#1A2130",
      "inset": "#0E131B",
      "overlay": "rgba(11, 14, 20, 0.72)"
    },
    "border": {
      "subtle": "#242C3B",
      "strong": "#36415A",
      "focus": "#4C8DFF"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#9BA6B8",
      "disabled": "#616C80",
      "onAccent": "#FFFFFF",
      "accent": "#8FB4FF"
    },
    "accent": {
      "base": "#3B7BF6",
      "hover": "#4C8DFF",
      "pressed": "#2A5FC4",
      "soft": "rgba(59, 123, 246, 0.18)",
      "onAccent": "#FFFFFF"
    },
    "status": {
      "success": "#22C55E",
      "warning": "#F5A524",
      "error": "#F05252",
      "info": "#38BDF8"
    }
  },
  "type": {
    "family": {
      "primary": "Inter",
      "mono": "JetBrains Mono"
    },
    "display": { "size": 40, "lineHeight": 1.15, "weight": 700 },
    "title": { "size": 28, "lineHeight": 1.2, "weight": 600 },
    "heading": { "size": 22, "lineHeight": 1.25, "weight": 600 },
    "body": { "size": 16, "lineHeight": 1.5, "weight": 400 },
    "label": { "size": 14, "lineHeight": 1.4, "weight": 500 },
    "caption": { "size": 12, "lineHeight": 1.4, "weight": 400 }
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "full": 999
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "curve": "easeInOutCubic"
  },
  "elevation": {
    "none": "none",
    "low": "0 1px 2px rgba(0, 0, 0, 0.24)",
    "medium": "0 4px 12px rgba(0, 0, 0, 0.32)",
    "high": "0 12px 32px rgba(0, 0, 0, 0.40)"
  },
  "layout": {
    "unit": 4,
    "breakpoints": {
      "compact": 0,
      "medium": 600,
      "expanded": 1024,
      "large": 1440
    },
    "gutters": {
      "compact": 16,
      "medium": 24,
      "expanded": 32,
      "large": 48
    },
    "maxContentWidth": 1280,
    "safeArea": 24
  }
}
